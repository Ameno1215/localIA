# PC de test (RTX 8 Go). Copier en .env puis changer les secrets :  cp .env.example .env
# Pour le DGX Spark : partir de .env.spark.example.
# Clé maître LiteLLM (admin). Doit commencer par "sk-".
LITELLM_MASTER_KEY=sk-change-moi-maitre
POSTGRES_PASSWORD=change-moi-postgres
WEBUI_SECRET_KEY=change-moi-webui

# Modèle servi par vLLM sous le nom "qwen-local" (dossier dans ./models).
# Qwen3.5-4B AWQ : attention hybride -> 64K de contexte dans 8 Go (cache ~120K tokens).
VLLM_MODEL=Qwen3.5-4B-AWQ
VLLM_MAX_MODEL_LEN=65536
VLLM_GPU_UTIL=0.88
VLLM_MAX_SEQS=2
# Parser d'appels d'outils et options propres au modèle. Raisonnement activé : plus juste pour coder.
# (Ancien modèle Qwen3-4B-Instruct-2507-FP8 : VLLM_TOOL_PARSER=hermes, VLLM_EXTRA_ARGS vide, contexte 20480.)
VLLM_TOOL_PARSER=qwen3_coder
VLLM_EXTRA_ARGS=--reasoning-parser qwen3 --language-model-only

# Vide au départ. Après l'entraînement LoRA (finetune/), mettre :
# VLLM_LORA_ARGS=--enable-lora --max-lora-rank 32 --lora-modules normes=/loras/normes
VLLM_LORA_ARGS=

# Serveur MCP : 1 = outils fichiers/commandes pour l'agent NAT local ; 0 = seulement la recherche dans les normes
MCP_OUTILS_CODE=1

# NemoClaw : adresse du pont OpenShell (docker network inspect openshell-docker).
# Laisser vide si NemoClaw n'est pas installé.
OPENSHELL_BRIDGE_IP=
