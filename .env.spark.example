# .env pour le DGX Spark (⚠ valeurs à valider sur place).  cp .env.spark.example .env
# Générer les secrets :  openssl rand -hex 16

# Dossier des DONNÉES des conteneurs : modèles, caches de compilation, bases (Postgres, Qdrant, Open WebUI),
# documents des normes, certificats. Tout ce qui n'est pas de la configuration. Absolu (ex. /home/data/ws)
# ou relatif au projet. Prévoir de la place : les modèles se comptent en centaines de Go.
WS_DIR=./ws
# Dossier des normes et documents indexés (défaut : WS_DIR/docs-internes). ./docs-internes = le dossier du projet,
# ignoré par git (les PDF ne sont jamais publiés). Changer de dossier : docker compose up -d mcp-docs, puis ingest.py.
#DOCS_DIR=./docs-internes

# Fait que TOUTE commande `docker compose` (et le panneau web) utilise la config Spark sans -f
COMPOSE_FILE=docker-compose.yml:docker-compose.spark.yml

LITELLM_MASTER_KEY=sk-change-moi-maitre
POSTGRES_PASSWORD=change-moi-postgres
WEBUI_SECRET_KEY=change-moi-webui

# Nom DNS (ou IP) du Spark sur le réseau interne, et jeton d'équipe pour la recherche dans les normes
SPARK_HOSTNAME=spark1.lan
MCP_TOKEN=change-moi-jeton-mcp
# Open WebUI aussi en HTTP simple sur le réseau (http://<ip-du-spark>:3000) : décommenter pour un test.
# ⚠ Mots de passe et conversations circulent en clair sur le réseau. Le HTTPS (port 8443) reste disponible.
#OPEN_WEBUI_HTTP=0.0.0.0

# --- vLLM : réglages du modèle actif (profil config/modeles-spark/nemotron-3.5-super-vl-120b-a12b-nvfp4.env, recette NVIDIA validée le 15/10/2026 avec le pilote 580) ---
# Pour changer de modèle, ne modifie pas ces lignes à la main :  ./scripts/modeles.py utiliser <profil>
# (voir ./scripts/modeles.py lister, chercher, ajouter). Image communautaire eugr/spark-vllm (ARM64), tag figé de la recette NVIDIA.
# Si vLLM plante ou est lent : vider VLLM_SPEC_ARGS (brouillon LiLiCorr), ou revenir au modèle plus léger : ./scripts/modeles.py utiliser qwen3.6-35b-a3b-nvfp4
VLLM_IMAGE=eugr/spark-vllm:nightly-20261015
# Image des embeddings/reranker (indépendante du modèle)
VLLM_POOLING_IMAGE=vllm/vllm-openai:v0.30.0
VLLM_MODEL=NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4
VLLM_MAX_MODEL_LEN=262144
# 0.74 pour le LLM (0.8 dans les recettes NVIDIA, modèle seul) : avec la pile complète il ne reste que ~92 Gio libres au démarrage
VLLM_GPU_UTIL=0.74
VLLM_MAX_SEQS=8
VLLM_TOOL_PARSER=qwen3_coder
VLLM_EXTRA_ARGS=--trust-remote-code --kv-cache-dtype fp8 --max-num-batched-tokens 8192 --mamba-backend flashinfer --mamba-ssm-cache-dtype float16 --enable-mamba-cache-stochastic-rounding --mamba-cache-philox-rounds 5 --enable-mamba-shared-prefix-checkpoint --prefix-match-unit 64 --block-size 64 --reasoning-parser nemotron_v3 --mm-processor-cache-gb 0 --limit-mm-per-prompt '{"video": 1, "image": 1}' --video-pruning-rate 0.5 --media-io-kwargs '{"video": {"fps": 2, "num_frames": 256}}' --load-format instanttensor
VLLM_SPEC_ARGS=--speculative_config.model /models/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4-LiLiCorr --speculative_config.method dflash --speculative_config.num_speculative_tokens 7
# Vide au départ. Une LoRA est liée à son modèle de base : à réentraîner si tu changes de modèle.
VLLM_LORA_ARGS=

MCP_OUTILS_CODE=0

# --- vLLM joignable par le réseau (serveur annexe, 2e Spark) : voir SPARK-DUO.md ---
# Clé exigée par vLLM (openssl rand -hex 16). Vide = aucune : seulement si vLLM n'écoute qu'en local.
VLLM_API_KEY=
# 0.0.0.0 pour que le serveur annexe joigne vLLM (Spark seul ; en duo, vLLM écoute toujours sur le réseau)
#VLLM_ECOUTE=0.0.0.0
# Sur le serveur annexe seulement : adresse de vLLM (le Spark 1)
#VLLM_API_BASE=http://spark1.lan:8000/v1

# --- Duo de Spark reliés par le câble QSFP (docker-compose.spark-duo.yml / spark-worker.yml) ---
# Interface et carte RDMA du câble : `ibdev2netdev` sur le Spark, la ligne « (Up) ». Mêmes noms sur les deux Spark
# si le câble est branché sur le même port de chaque côté.
#DUO_INTERFACE=enp1s0f0np0
#DUO_HCA=rocep1s0f0
# Adresses fixées sur le câble (netplan, SPARK-DUO.md étape 2)
#DUO_IP_TETE=192.168.100.10
#DUO_IP_WORKER=192.168.100.11
#DUO_NCCL_DEBUG=INFO
