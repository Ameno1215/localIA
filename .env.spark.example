# .env pour le DGX Spark (⚠ valeurs à valider sur place).  cp .env.spark.example .env
# Générer les secrets :  openssl rand -hex 16

# Fait que TOUTE commande `docker compose` (et le panneau web) utilise la config Spark sans -f
COMPOSE_FILE=docker-compose.yml:docker-compose.spark.yml

LITELLM_MASTER_KEY=sk-change-moi-maitre
POSTGRES_PASSWORD=change-moi-postgres
WEBUI_SECRET_KEY=change-moi-webui

# Nom DNS (ou IP) du Spark sur le réseau interne, et jeton d'équipe pour la recherche dans les normes
SPARK_HOSTNAME=spark1.lan
MCP_TOKEN=change-moi-jeton-mcp

# --- vLLM : réglages du modèle actif (profil config/modeles-spark/qwen3.6-35b-a3b-nvfp4.env) ---
# Pour changer de modèle, ne modifie pas ces lignes à la main :  ./scripts/modeles.py utiliser <profil>
# (voir ./scripts/modeles.py lister, chercher, ajouter). Image arm64 ; NVFP4 sur GB10 demande vLLM >= 0.28.
# Si vLLM plante ou est lent, essayer l'image NVIDIA du playbook Spark (build.nvidia.com/spark/vllm),
# par exemple VLLM_IMAGE=nvcr.io/nvidia/vllm:<tag> (docker login nvcr.io avec une clé NGC).
VLLM_IMAGE=vllm/vllm-openai:v0.30.0
# Image des embeddings/reranker (indépendante du modèle)
VLLM_POOLING_IMAGE=vllm/vllm-openai:v0.30.0
VLLM_MODEL=Qwen3.6-35B-A3B-NVFP4
VLLM_MAX_MODEL_LEN=262144
# Mémoire unifiée partagée avec l'hôte : 0.5 pour ce modèle (+ 2 x 0.04 pour bge-m3/reranker)
VLLM_GPU_UTIL=0.5
VLLM_MAX_SEQS=8
VLLM_TOOL_PARSER=qwen3_coder
VLLM_EXTRA_ARGS=--kv-cache-dtype fp8 --attention-backend flashinfer --moe-backend marlin --max-num-batched-tokens 8192 --enable-chunked-prefill --async-scheduling --enable-prefix-caching --load-format fastsafetensors --reasoning-parser qwen3 --trust-remote-code
VLLM_SPEC_ARGS=--speculative-config '{"method":"mtp","num_speculative_tokens":3,"moe_backend":"triton"}'
# Vide au départ. Une LoRA est liée à son modèle de base : à réentraîner si tu changes de modèle.
VLLM_LORA_ARGS=

MCP_OUTILS_CODE=0
