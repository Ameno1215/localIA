# NVIDIA Nemotron 3.5 Bolt : 74 Md de paramètres (9 Md actifs) comprimé à 24 Go (experts en ~2 bits), conçu pour les agents locaux.
# Source : recette NVIDIA models/nvidia/nemotron-3.5-bolt-74b-a9b/dgx-spark/linux/vllm/128gb/iq2 (github.com/NVIDIA/local-ai-inference-recipes), « optimized », validée le 15/10/2026.
# Débit mesuré par NVIDIA : 89 tok/s en génération de code (1 requête, Spark 128 Go).
# ⚠ Image COMMUNAUTAIRE eugr/spark-vllm (tag figé de la recette NVIDIA, ARM64 vérifié). Pas de b12x ni de plugin à installer : la recette officielle est plus simple que la fiche Hugging Face.
# ⚠ Brouillon « LiLiCorr » (~1 Go, décodage spéculatif DFlash) téléchargé avec le modèle. La recette NVIDIA règle --max-model-len auto ; fixé ici à 131072.
# ⚠ Réserve 0.8 de la mémoire (recette NVIDIA) alors que le modèle ne pèse que 24 Go : à baisser pour faire cohabiter un second modèle.

MODELE_HF=nvidia/NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB
MODELE_DOSSIER=NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB
MODELE_EXTRA_HF=nvidia/NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB-LiLiCorr

VLLM_MODEL=NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB
VLLM_IMAGE=eugr/spark-vllm:nightly-20261015
VLLM_MAX_MODEL_LEN=131072
VLLM_GPU_UTIL=0.8
VLLM_MAX_SEQS=8
VLLM_TOOL_PARSER=qwen3_coder
VLLM_EXTRA_ARGS=--trust-remote-code --kv-cache-dtype fp8 --max-num-batched-tokens 8192 --load-format instanttensor --reasoning-parser nemotron_v3 --enable-mamba-shared-prefix-checkpoint --block-size 64 --prefix-match-unit 64
VLLM_SPEC_ARGS=--speculative_config.model /models/NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB-LiLiCorr --speculative_config.method dflash --speculative_config.num_speculative_tokens 7
