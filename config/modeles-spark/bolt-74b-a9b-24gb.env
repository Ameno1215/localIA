# NVIDIA Nemotron 3.5 Bolt : 74 Md de paramètres (9 Md actifs) comprimé à 24 Go (experts en ~2 bits). Pensé pour les agents locaux.
# Source : https://huggingface.co/nvidia/NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB  (fiche du modèle ; PAS de recette vLLM, rédigé à la main le 21/10/2026)
# ⚠ EXPÉRIMENTAL : paru en octobre 2026, pas de recette GB10 vérifiée. Les scores de la fiche sont ceux de NVIDIA, à confirmer sur tes tâches.
# ⚠ Image construite localement (services/vllm-bolt/Dockerfile) : vLLM figé + paquet b12x + noyaux. Premier « utiliser » : build avec internet.
# ⚠ La fiche vise 1 requête à la fois (--max-num-seqs 1) ; mis ici à 4 pour l'équipe, à vérifier (baisser si instable).
# ⚠ Décodage spéculatif DFlash avec le brouillon « LiLiCorr » (1 Go), téléchargé avec le modèle.
# ⚠ Options vision/vidéo de la fiche retirées (usage texte/code) ; --allowed-local-media-path / volontairement non repris.

MODELE_HF=nvidia/NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB
MODELE_DOSSIER=NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB
MODELE_EXTRA_HF=nvidia/NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB-LiLiCorr
IMAGE_CONTEXTE=services/vllm-bolt
IMAGE_APRES_BUILD=vllm download-kernels

VLLM_MODEL=NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB
VLLM_IMAGE=ia-locale/vllm-bolt:local
VLLM_MAX_MODEL_LEN=131072
VLLM_GPU_UTIL=0.5
VLLM_MAX_SEQS=4
VLLM_TOOL_PARSER=qwen3_coder
VLLM_EXTRA_ARGS=--trust-remote-code --load-format auto --enable-chunked-prefill --kv-cache-dtype fp8 --linear-backend b12x --moe-backend b12x --attention-backend FLASHINFER --mamba-backend flashinfer --mamba-ssm-cache-dtype bfloat16 --mamba-cache-dtype bfloat16 --mamba-cache-mode align --seed 42 --reasoning-parser-plugin /opt/ultra_v3_reasoning_parser.py --reasoning-parser ultra_v3
VLLM_SPEC_ARGS=--speculative-config '{"method":"dflash","model":"/models/NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB-LiLiCorr","num_speculative_tokens":7,"rejection_sample_method":"standard","attention_backend":"FLASHINFER","draft_load_config":{"load_format":"auto"}}'
ENV_VLLM_USE_V2_MODEL_RUNNER=1
