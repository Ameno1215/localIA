# Google's Gemma 4 MoE multimodal model (26B total / 4B active) with 128 fine-grained experts, top-8 routing, th
# Source : https://recipes.vllm.ai/nvidia/Gemma-4-26B-A4B-NVFP4?hardware=dgx_spark_gb10  (statut GB10 : verified, généré le 21/10/2026)
# ⚠ Image NON officielle : eugr/spark-vllm:nightly-20260704. À vérifier (architecture arm64, origine) avant usage.
# ⚠ Décodage spéculatif (mtp) non activé : il demande un modèle brouillon séparé.
# ⚠ Une option référence un fichier du dépôt vLLM (examples/…) : vérifier qu'il existe dans l'image, sinon le copier dans ./models.

MODELE_HF=nvidia/Gemma-4-26B-A4B-NVFP4
MODELE_DOSSIER=Gemma-4-26B-A4B-NVFP4

VLLM_MODEL=Gemma-4-26B-A4B-NVFP4
VLLM_IMAGE=eugr/spark-vllm:nightly-20260704
VLLM_MAX_MODEL_LEN=262144
VLLM_GPU_UTIL=0.8
VLLM_MAX_SEQS=8
VLLM_TOOL_PARSER=gemma4
VLLM_EXTRA_ARGS=--max-num-batched-tokens 8192 --enable-prefix-caching --load-format fastsafetensors --reasoning-parser gemma4 --chat-template examples/tool_chat_template_gemma4.jinja
VLLM_SPEC_ARGS=
ENV_VLLM_USE_V2_MODEL_RUNNER=1
