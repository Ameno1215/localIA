# Ling-3.0-flash MoE model with BF16, FP8, FP4, and INT4 checkpoints, native MTP, and an external DSpark draft …
# Source : https://recipes.vllm.ai/inclusionAI/Ling-3.0-flash-fp4?hardware=dgx_spark_gb10  (statut GB10 : verified, généré le 21/10/2026)
# ⚠ La recette indique vllm/vllm-openai:latest, remplacée par l'image du projet vllm/vllm-openai:v0.30.0 (plus récente, épinglée).
# ⚠ Gros modèle (85 Go) : peu de marge pour le système et les autres services. Garder VLLM_MAX_SEQS bas (4 ou moins).
# ⚠ Pas de réglages GB10 dans la recette : valeurs par défaut du projet, À VÉRIFIER au premier démarrage.

MODELE_HF=inclusionAI/Ling-3.0-flash-fp4
MODELE_DOSSIER=Ling-3.0-flash-fp4

VLLM_MODEL=Ling-3.0-flash-fp4
VLLM_IMAGE=vllm/vllm-openai:v0.30.0
VLLM_MAX_MODEL_LEN=131072
VLLM_GPU_UTIL=0.82
VLLM_MAX_SEQS=4
VLLM_TOOL_PARSER=ling3
VLLM_EXTRA_ARGS=--reasoning-parser ling3 --trust-remote-code
VLLM_SPEC_ARGS=--speculative-config '{"method":"mtp","num_speculative_tokens":3}'
