# NVIDIA Nemotron-3-Super Mamba-hybrid latent-MoE (~120B total / ~12B active) with BF16, FP8, and NVFP4 variants
# Source : https://recipes.vllm.ai/nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4?hardware=dgx_spark_gb10  (statut GB10 : verified, généré le 21/10/2026)
# ⚠ La recette indique vllm/vllm-openai:latest, remplacée par l'image du projet vllm/vllm-openai:v0.30.0 (plus récente, épinglée).
# ⚠ Gros modèle (75 Go) : peu de marge pour le système et les autres services. Garder VLLM_MAX_SEQS bas (4 ou moins).
# ⚠ Pas de réglages GB10 dans la recette : valeurs par défaut du projet, À VÉRIFIER au premier démarrage.

MODELE_HF=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4
MODELE_DOSSIER=NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4

VLLM_MODEL=NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4
VLLM_IMAGE=vllm/vllm-openai:v0.30.0
VLLM_MAX_MODEL_LEN=131072
VLLM_GPU_UTIL=0.8
VLLM_MAX_SEQS=4
VLLM_TOOL_PARSER=qwen3_coder
VLLM_EXTRA_ARGS=--reasoning-parser nemotron_v3 --trust-remote-code
VLLM_SPEC_ARGS=
