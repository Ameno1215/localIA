# NVIDIA Nemotron 3.5 Lightning hybrid Mamba-MoE (30B total / 3B active) with NVFP4 and BF16 checkpoints, 1M con
# Source : https://recipes.vllm.ai/nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4?hardware=dgx_spark_gb10  (statut GB10 : verified, généré le 21/10/2026)
# ⚠ La recette indique vllm/vllm-openai:nightly, remplacée par l'image du projet vllm/vllm-openai:v0.30.0 (plus récente, épinglée).
# ⚠ Mode spéculatif par défaut (dspark) ignoré : il demande un modèle brouillon à télécharger. MTP utilisé.

MODELE_HF=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4
MODELE_DOSSIER=NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4

VLLM_MODEL=NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4
VLLM_IMAGE=vllm/vllm-openai:v0.30.0
VLLM_MAX_MODEL_LEN=131072
VLLM_GPU_UTIL=0.7
VLLM_MAX_SEQS=8
VLLM_TOOL_PARSER=qwen3_coder
VLLM_EXTRA_ARGS=--kv-cache-dtype fp8 --moe-backend marlin --load-format fastsafetensors --reasoning-parser nemotron_v3
VLLM_SPEC_ARGS=--speculative-config '{"method":"mtp","num_speculative_tokens":3}'
