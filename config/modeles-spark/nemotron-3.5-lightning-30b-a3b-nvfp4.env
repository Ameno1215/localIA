# NVIDIA Nemotron 3.5 Lightning : MoE hybride Mamba, 30 Md de paramètres (3 Md actifs), NVFP4 (~18 Go). Le plus rapide mesuré par NVIDIA.
# Source : recette NVIDIA models/nvidia/nemotron-3.5-lightning-30b-a3b/dgx-spark/linux/vllm/64gb/nvfp4 (github.com/NVIDIA/local-ai-inference-recipes), « optimized », validée le 20/10/2026.
# Débit mesuré par NVIDIA : 144 tok/s en génération de code (1 requête). Seule recette publiée : celle du Spark 64 Go (valable aussi pour 128 Go).
# ⚠ Image COMMUNAUTAIRE eugr/spark-vllm (tag figé de la recette NVIDIA, ARM64 vérifié).
# ⚠ Brouillon « DSpark » (décodage spéculatif) téléchargé avec le modèle. Contexte et nombre de séquences non fixés par la recette : 131072 et 8 choisis ici.

MODELE_HF=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4
MODELE_DOSSIER=NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4
MODELE_EXTRA_HF=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4-DSpark

VLLM_MODEL=NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4
VLLM_IMAGE=eugr/spark-vllm:nightly-20261016
VLLM_MAX_MODEL_LEN=131072
VLLM_GPU_UTIL=0.8
VLLM_MAX_SEQS=8
VLLM_TOOL_PARSER=qwen3_xml
VLLM_EXTRA_ARGS=--moe-backend marlin --kv-cache-dtype fp8 --max-num-batched-tokens 4096 --enable-prefix-caching --mamba-backend flashinfer --mamba-cache-mode align --mamba-ssm-cache-dtype float16 --enable-mamba-cache-stochastic-rounding --mamba-cache-philox-rounds 5 --reasoning-parser nemotron_v3 --load-format safetensors
VLLM_SPEC_ARGS=--speculative_config.method dspark --speculative_config.model /models/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4-DSpark --speculative_config.num_speculative_tokens 7
