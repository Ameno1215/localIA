# 120B total / 12B active vision-language model with NVFP4, FP8, and BF16 recipes for H100, H200, GB200, DGX …
# Source : https://recipes.vllm.ai/nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4?hardware=dgx_spark_gb10  (statut GB10 : verified, généré le 21/10/2026)
# ⚠ Image spécifique à ce modèle : vllm/vllm-openai:v0.31.0.
# ⚠ Décodage spéculatif (mtp) non activé : il demande un modèle brouillon séparé.
# ⚠ Gros modèle (91 Go) : peu de marge pour le système et les autres services. Garder VLLM_MAX_SEQS bas (4 ou moins).
# ⚠ Pas de réglages GB10 dans la recette : valeurs par défaut du projet, À VÉRIFIER au premier démarrage.

MODELE_HF=nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4
MODELE_DOSSIER=NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4

VLLM_MODEL=NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4
VLLM_IMAGE=vllm/vllm-openai:v0.31.0
VLLM_MAX_MODEL_LEN=131072
VLLM_GPU_UTIL=0.82
VLLM_MAX_SEQS=4
VLLM_TOOL_PARSER=qwen3_coder
VLLM_EXTRA_ARGS=--no-enable-prefix-caching --async-scheduling --mamba-backend flashinfer --mamba-ssm-cache-dtype float16 --enable-mamba-cache-stochastic-rounding --mamba-cache-philox-rounds 5 --chat-template-content-format string --mamba-cache-mode align --reasoning-parser nemotron_v3 --trust-remote-code
VLLM_SPEC_ARGS=
