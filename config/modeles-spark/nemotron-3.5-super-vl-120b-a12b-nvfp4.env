# NVIDIA Nemotron 3.5 Super VL : 120 Md de paramètres (12 Md actifs), vision + texte, NVFP4 (75 Go). Modèle par défaut du Spark.
# Le plus gros Nemotron 3.5 qui tient sur un Spark 128 Go (sorti le 15/10/2026 ; il n'existe pas d'Ultra 3.5, et l'Ultra 3 fait 550 Md).
# Source : recette NVIDIA models/nvidia/nemotron-3.5-super-vl-120b-a12b/dgx-spark/linux/vllm/nvfp4 (github.com/NVIDIA/local-ai-inference-recipes), « optimized », validée le 15/10/2026
# sur DGX Spark 128 Go avec le pilote 580.159.03 et CUDA 13.0 (vLLM 0.32.0rc1 du 15/10/2026).
# Débit mesuré par NVIDIA : 51 tok/s en génération de code (1 requête, Spark 128 Go).
# ⚠ Image COMMUNAUTAIRE eugr/spark-vllm. La recette NVIDIA indique « latest » ; fixé ici sur nightly-20261015 (même build vLLM que la recette, ARM64 vérifié).
# ⚠ Brouillon « LiLiCorr » (1,3 Go, décodage spéculatif DFlash) téléchargé avec le modèle. La recette règle --max-model-len auto (jusqu'à 1M) ; fixé à 262144.
# ⚠ Occupe l'essentiel de la mémoire (0.74 réservé + embeddings) : rien d'autre de lourd sur le GPU.
# 0.74 et non 0.8 (recette NVIDIA, modèle seul) : mesuré sur le Spark, la pile complète (système, embeddings, reranker,
# Open WebUI…) occupe ~30 Gio avant vLLM ; il en reste ~92 Gio, et vLLM refuse de démarrer à 0.8 (97 Gio).

MODELE_HF=nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4
MODELE_DOSSIER=NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4
MODELE_EXTRA_HF=nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4-LiLiCorr

VLLM_MODEL=NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4
VLLM_IMAGE=eugr/spark-vllm:nightly-20261015
VLLM_MAX_MODEL_LEN=262144
VLLM_GPU_UTIL=0.74
VLLM_MAX_SEQS=8
VLLM_TOOL_PARSER=qwen3_coder
VLLM_EXTRA_ARGS=--trust-remote-code --kv-cache-dtype fp8 --max-num-batched-tokens 8192 --mamba-backend flashinfer --mamba-ssm-cache-dtype float16 --enable-mamba-cache-stochastic-rounding --mamba-cache-philox-rounds 5 --enable-mamba-shared-prefix-checkpoint --prefix-match-unit 64 --block-size 64 --reasoning-parser nemotron_v3 --mm-processor-cache-gb 0 --limit-mm-per-prompt '{"video": 1, "image": 1}' --video-pruning-rate 0.5 --media-io-kwargs '{"video": {"fps": 2, "num_frames": 256}}' --load-format instanttensor
VLLM_SPEC_ARGS=--speculative_config.model /models/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4-LiLiCorr --speculative_config.method dflash --speculative_config.num_speculative_tokens 7
