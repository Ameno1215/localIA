# Ornith 1.5 122B (ornith-ai) : MoE de 122 Md (256 experts, 8 par token), architecture Qwen3.5, licence MIT, NVFP4 (~70 Go).
# Source : https://huggingface.co/ornith-ai/Ornith-1.5-122B-NVFP4  (fiche du modèle ; PAS de recette vLLM ; profil rédigé le 21/10/2026)
# ⚠ EXPÉRIMENTAL : publié le 20/10/2026 par un éditeur tiers, 0 retour d'usage. Scores de la fiche (SWE-bench Verified 84,5, TerminalBench 2.1 81,2) fournis par l'éditeur, NON vérifiés.
# ⚠ Aucune validation sur DGX Spark : options reprises de la recette GB10 de Qwen3.6-35B NVFP4 (même famille, même format modelopt) + préconisations de la fiche (parsers qwen3_xml / qwen3).
# ⚠ Si vLLM refuse le checkpoint : essayer sans --moe-backend marlin, puis une image plus récente (VLLM_IMAGE).

MODELE_HF=ornith-ai/Ornith-1.5-122B-NVFP4
MODELE_DOSSIER=Ornith-1.5-122B-NVFP4

VLLM_MODEL=Ornith-1.5-122B-NVFP4
VLLM_IMAGE=vllm/vllm-openai:v0.31.0
VLLM_MAX_MODEL_LEN=262144
VLLM_GPU_UTIL=0.75
VLLM_MAX_SEQS=8
VLLM_TOOL_PARSER=qwen3_xml
VLLM_EXTRA_ARGS=--kv-cache-dtype fp8 --attention-backend flashinfer --moe-backend marlin --max-num-batched-tokens 8192 --enable-chunked-prefill --async-scheduling --enable-prefix-caching --reasoning-parser qwen3
VLLM_SPEC_ARGS=
