# Qwen3.6 dense multimodal model (27B) with gated delta networks hybrid attention, MTP, and 262K context
# Source : https://recipes.vllm.ai/nvidia/Qwen3.6-27B-NVFP4?hardware=dgx_spark_gb10  (statut GB10 : verified, généré le 21/10/2026)
# ⚠ La recette indique vllm/vllm-openai:latest, remplacée par l'image du projet vllm/vllm-openai:v0.30.0 (plus récente, épinglée).

MODELE_HF=nvidia/Qwen3.6-27B-NVFP4
MODELE_DOSSIER=Qwen3.6-27B-NVFP4

VLLM_MODEL=Qwen3.6-27B-NVFP4
VLLM_IMAGE=vllm/vllm-openai:v0.30.0
VLLM_MAX_MODEL_LEN=262144
VLLM_GPU_UTIL=0.5
VLLM_MAX_SEQS=8
VLLM_TOOL_PARSER=qwen3_coder
VLLM_EXTRA_ARGS=--kv-cache-dtype fp8 --attention-backend flashinfer --max-num-batched-tokens 8192 --enable-chunked-prefill --enable-prefix-caching --load-format fastsafetensors --async-scheduling --reasoning-parser qwen3 --trust-remote-code
VLLM_SPEC_ARGS=--speculative-config '{"method":"mtp","num_speculative_tokens":5}'
