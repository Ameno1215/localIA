# Smaller Qwen3.6 multimodal MoE model (35B total / 3B active) with BF16, FP8, and NVIDIA NVFP4 variants
# Parser d'outils aligné sur la recette NVIDIA du modèle NVFP4 (qwen3_xml, validé par NVIDIA pour Qwen3.6).
# Source : https://recipes.vllm.ai/Qwen/Qwen3.6-35B-A3B-FP8?hardware=dgx_spark_gb10  (statut GB10 : verified, généré le 21/10/2026)
# ⚠ La recette indique vllm/vllm-openai:latest, remplacée par l'image du projet vllm/vllm-openai:v0.30.0 (plus récente, épinglée).
# ⚠ Pas de réglages GB10 dans la recette : valeurs par défaut du projet, À VÉRIFIER au premier démarrage.

MODELE_HF=Qwen/Qwen3.6-35B-A3B-FP8
MODELE_DOSSIER=Qwen3.6-35B-A3B-FP8

VLLM_MODEL=Qwen3.6-35B-A3B-FP8
VLLM_IMAGE=vllm/vllm-openai:v0.30.0
VLLM_MAX_MODEL_LEN=131072
VLLM_GPU_UTIL=0.5
VLLM_MAX_SEQS=8
VLLM_TOOL_PARSER=qwen3_xml
VLLM_EXTRA_ARGS=--reasoning-parser qwen3 --trust-remote-code
VLLM_SPEC_ARGS=--speculative-config '{"method":"mtp","num_speculative_tokens":3,"moe_backend":"triton"}'
