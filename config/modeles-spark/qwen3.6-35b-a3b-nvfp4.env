# Qwen3.6-35B-A3B (Alibaba), quantifié NVFP4 par NVIDIA : 35 Md de paramètres, 3 Md actifs, MTP. Modèle par défaut du projet.
# Source : recette NVIDIA models/qwen/qwen3.6-35b-a3b/dgx-spark/linux/vllm/128gb (github.com/NVIDIA/local-ai-inference-recipes), statut « optimized », validée le 19/10/2026.
# Débit mesuré par NVIDIA : 124 tok/s en génération de code (1 requête, DGX Spark).
# Image : conteneur NGC de NVIDIA (vLLM 0.31, build NVIDIA), public, ARM64 vérifié. Alternative vLLM officiel : VLLM_IMAGE=vllm/vllm-openai:v0.30.0 + --load-format fastsafetensors.
# Parser d'outils : qwen3_xml (celui validé par NVIDIA pour Qwen3.6 et 3.8 ; qwen3_coder était l'ancien choix).

MODELE_HF=nvidia/Qwen3.6-35B-A3B-NVFP4
MODELE_DOSSIER=Qwen3.6-35B-A3B-NVFP4

VLLM_MODEL=Qwen3.6-35B-A3B-NVFP4
VLLM_IMAGE=nvcr.io/nvidia/vllm:26.10.pre1-py3
VLLM_MAX_MODEL_LEN=262144
VLLM_GPU_UTIL=0.8
VLLM_MAX_SEQS=8
VLLM_TOOL_PARSER=qwen3_xml
VLLM_EXTRA_ARGS=--trust-remote-code --kv-cache-dtype fp8 --attention-backend flashinfer --moe-backend marlin --max-num-batched-tokens 8192 --enable-chunked-prefill --async-scheduling --enable-prefix-caching --load-format safetensors --reasoning-parser qwen3
VLLM_SPEC_ARGS=--speculative-config '{"method":"mtp","num_speculative_tokens":4,"moe_backend":"triton"}'
