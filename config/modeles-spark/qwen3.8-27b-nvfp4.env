# 27B-parameter dense hybrid-attention model with linear attention on 48 of 64 layers, a vision tower, a built-i
# Source : https://recipes.vllm.ai/nvidia/Qwen3.8-27B-NVFP4?hardware=dgx_spark_gb10  (statut GB10 : verified, généré le 21/10/2026)
# ⚠ Image spécifique à ce modèle : vllm/vllm-openai:qwen38.

MODELE_HF=nvidia/Qwen3.8-27B-NVFP4
MODELE_DOSSIER=Qwen3.8-27B-NVFP4

VLLM_MODEL=Qwen3.8-27B-NVFP4
VLLM_IMAGE=vllm/vllm-openai:qwen38
VLLM_MAX_MODEL_LEN=262144
VLLM_GPU_UTIL=0.7
VLLM_MAX_SEQS=8
VLLM_TOOL_PARSER=qwen3_coder
VLLM_EXTRA_ARGS=--kv-cache-dtype fp8 --max-num-batched-tokens 8192 --enable-chunked-prefill --async-scheduling --enable-prefix-caching --load-format fastsafetensors --reasoning-parser qwen3
VLLM_SPEC_ARGS=--speculative-config '{"method":"mtp","num_speculative_tokens":5}'
