# Qwen3.8-27B (Alibaba), dense, quantifié NVFP4 par NVIDIA : modèle recommandé par le playbook NVIDIA vLLM pour le Spark 128 Go.
# Source : recette NVIDIA models/qwen/qwen3.8-27b/dgx-spark/linux/vllm/128gb/nvfp4 (github.com/NVIDIA/local-ai-inference-recipes), « optimized », validée le 19/10/2026.
# Débit mesuré par NVIDIA : 37 tok/s en génération de code (1 requête). Modèle dense : plus lent que les modèles MoE.
# Image : conteneur NGC de NVIDIA (vLLM 0.31, build NVIDIA), public, ARM64 vérifié.
# ⚠ Brouillon « DFlash2 » (z-lab, décodage spéculatif) téléchargé avec le modèle.

MODELE_HF=nvidia/Qwen3.8-27B-NVFP4
MODELE_DOSSIER=Qwen3.8-27B-NVFP4
MODELE_EXTRA_HF=z-lab/Qwen3.8-27B-DFlash2

VLLM_MODEL=Qwen3.8-27B-NVFP4
VLLM_IMAGE=nvcr.io/nvidia/vllm:26.10.pre1-py3
VLLM_MAX_MODEL_LEN=262144
VLLM_GPU_UTIL=0.60
VLLM_MAX_SEQS=8
VLLM_TOOL_PARSER=qwen3_xml
VLLM_EXTRA_ARGS=--kv-cache-dtype fp8 --async-scheduling --enable-flashinfer-autotune --kernel-config '{"linear_backend":"nvfp4_dynamic","nvfp4_dynamic_max_tokens":16,"unquantized_linear_backend":"flashinfer_cudnn","linear_backend_per_quant":{"fp8_w8a8":"cutlass"}}' --compilation-config '{"pass_config":{"fuse_act_quant":true},"max_cudagraph_capture_size":64}' --reasoning-parser qwen3
VLLM_SPEC_ARGS=--speculative-config '{"method":"dflash","model":"/models/Qwen3.8-27B-DFlash2","num_speculative_tokens":7,"draft_sample_method":"probabilistic","rejection_sample_method":"standard"}'
