# Qwen3.8 Flash Next (Alibaba), quantifié NVFP4 par NVIDIA pour le matériel local : 125 Md de paramètres, 6 Md actifs, MTP, 262K de contexte.
# Source : recette NVIDIA models/qwen/qwen3.8-flash-next/dgx-spark/linux/vllm/fp4-local (github.com/NVIDIA/local-ai-inference-recipes), validée le 15/10/2026 : 37,8 tok/s mesurés (1 requête, code).
# Précision mesurée par NVIDIA vs BF16 : GPQA Diamond 91,5 % / 92,2 %, ToolEvalBench 88,7 % / 89,4 %.
# ⚠ Poids ~96 Gio (~103 Go) à télécharger : vérifier l'espace disque du Spark. Occupe ~0.8 de la mémoire : arrêter les autres gros usages du GPU.
# ⚠ Exige l'image COMMUNAUTAIRE eugr/spark-vllm-b12x (utilisée par la recette NVIDIA validée le 15/10/2026, tag figé nightly-20261015, ARM64 vérifié) : vLLM amont ne gère pas encore le format de ce checkpoint.
# ⚠ La fiche demande un conteneur moins isolé (seccomp/apparmor désactivés, pour io_uring) : généré dans .compose.vllm.yml, uniquement tant que ce profil est actif.
# ⚠ Réglages recopiés de la fiche, non testés ici. Les options vision (--mm-encoder-tp-mode) sont conservées comme dans la fiche.

MODELE_HF=nvidia/Qwen3.8-Flash-Next-FP4-Local
MODELE_DOSSIER=Qwen3.8-Flash-Next-FP4-Local

VLLM_MODEL=Qwen3.8-Flash-Next-FP4-Local
VLLM_IMAGE=eugr/spark-vllm-b12x:nightly-20261015
VLLM_MAX_MODEL_LEN=262144
VLLM_GPU_UTIL=0.8
VLLM_MAX_SEQS=8
VLLM_TOOL_PARSER=qwen3_xml
VLLM_EXTRA_ARGS=--pipeline-parallel-size 1 --mamba-cache-mode align --enable-prefix-caching --enable-chunked-prefill --dtype bfloat16 --kv-cache-dtype fp8 --quantization modelopt_mixed --block-size 16 --load-format b12x --max-num-batched-tokens 4096 --gdn-decode-kernel b12x --linear-backend b12x --moe-backend b12x --no-enable-flashinfer-autotune --mm-encoder-tp-mode data --reasoning-parser qwen3 --compilation-config '{"pass_config":{"fuse_act_quant":true}}'
VLLM_SPEC_ARGS=--speculative-config '{"method":"mtp","num_speculative_tokens":4}'
COMPOSE_EXTRA={"security_opt":["seccomp=unconfined","apparmor=unconfined"],"volumes":["${WS_DIR:-./ws}/cache/b12x:/root/.cache/b12x"]}
ENV_VLLM_PLE_TABLE_MEMORY=disk
ENV_B12X_DISK_BACKEND=io_uring
ENV_CUTE_DSL_ARCH=sm_121a
ENV_SAFETENSORS_FAST_GPU=1
ENV_VLLM_WORKER_MULTIPROC_METHOD=spawn
ENV_VLLM_SSM_CONV_STATE_LAYOUT=DS
ENV_VLLM_USE_AOT_COMPILE=1
ENV_VLLM_USE_MEGA_AOT_ARTIFACT=1
ENV_VLLM_USE_V2_MODEL_RUNNER=1
ENV_B12X_POLICY_MODE=auto
ENV_VLLM_MXFP8_LM_HEAD=1
ENV_VLLM_B12X_MOE_FP4_LAYER_MAX_INPUT_SCALE=w13
ENV_VLLM_B12X_MOE_FP4_FORCE_A16=1
ENV_B12X_W4A16_A4_PREFILL=1
